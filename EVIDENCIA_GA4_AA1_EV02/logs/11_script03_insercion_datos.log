SQL> -- ---------------- CALCULO DEL VALOR TOTAL ----------------
SQL> -- El valor total de cada factura es la suma de los subtotales de su detalle.
SQL> update facturas f
  2     set valor_total = (select nvl(sum(d.subtotal), 0)
  3                          from detalle_factura d
  4                         where d.numero_factura = f.numero_factura);

